# ==============================================================================
# Leiloar.com SaaS Auction Intelligence Framework - Configuration Template
# Copy this file to .env and adjust variables for your local or deployment environment.
# ==============================================================================

# Database storage path (local SQLite file or Postgres connection string)
LEILOAR_DATABASE_PATH=leiloar_radar.db

# Radar API Server bindings
LEILOAR_API_HOST=0.0.0.0
LEILOAR_API_PORT=8000

# Default Brazilian State (UF) for crawler operations (e.g., SP, RJ, MG, PR)
LEILOAR_DEFAULT_UF=SP

# Scraper throttle and rate limit delay in seconds
LEILOAR_REQUEST_DELAY_SECONDS=1.5

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LEILOAR_LOG_LEVEL=INFO
